/dts-v1/;

#include "nord-gearvm.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IQ10 RRD GearVM";
	compatible = "qcom,iq10-rrd", "qcom,nord";

	aliases {
		i2c18 = &i2c18;
		scmichannels = &reserved_memory;
		serial0 = &uart15;
		serial1 = &uart4;
		spi16 = &spi16;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	clocks {
		xo_board_clk: xo-board-clk {
			compatible = "fixed-clock";
			clock-frequency = <38400000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};
	};
};


&i2c18 {
	status = "okay";
};

&scmi3 {
	status = "okay";
};

&scmi9 {
	status = "okay";
};

&scmi10 {
	status = "okay";
};

&scmi11 {
	status = "okay";
};

&spi16 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&uart15 {
	status = "okay";
};

&ufs_mem_hc {
	status = "okay";
};
