/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/spmi/spmi.h>

#include "nord-gearvm.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IQ10 RRD GearVM";
	compatible = "qcom,iq10-rrd", "qcom,nord";

	aliases {
		i2c18 = &i2c18;
		scmichannels = &reserved_memory;
		serial0 = &uart15;
		serial1 = &uart4;
		spi16 = &spi16;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	clocks {
		xo_board_clk: xo-board-clk {
			compatible = "fixed-clock";
			clock-frequency = <38400000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};
	};
};


&i2c18 {
	status = "okay";
};

&scmi0 {
	status = "okay";
};

&scmi1 {
	status = "okay";
};

&scmi3 {
	status = "okay";
};

&scmi5 {
	status = "okay";
};

&scmi6 {
	status = "okay";
};

&scmi7 {
	status = "okay";
};

&scmi8 {
	status = "okay";
};

&scmi9 {
	status = "okay";
};

&scmi10 {
	status = "okay";
};

&scmi11 {
	status = "okay";
};

&scmi12 {
	status = "okay";
};

&scmi13 {
	status = "okay";
};

&scmi32 {
	status = "okay";
};

&scmi33 {
	status = "okay";
};

&spi16 {
	status = "okay";
};

&spmi_bus {
	pmau0102_e: pmic@4 {
		compatible = "qcom,pmau0102", "qcom,spmi-pmic";
		reg = <0x4 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pmau0102_e_gpios: gpio@8800 {
			compatible = "qcom,pmau0102-gpio", "qcom,spmi-gpio";
			reg = <0x8800>;
			gpio-controller;
			gpio-ranges = <&pmau0102_e_gpios 0 0 12>;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};

	pmau0102_f: pmic@5 {
		compatible = "qcom,pmau0102", "qcom,spmi-pmic";
		reg = <0x5 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pmau0102_f_gpios: gpio@8800 {
			compatible = "qcom,pmau0102-gpio", "qcom,spmi-gpio";
			reg = <0x8800>;
			gpio-controller;
			gpio-ranges = <&pmau0102_f_gpios 0 0 12>;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

&pcie0_fw {
	status = "okay";
};

&pcie1_fw {
	status = "okay";
};

&pcie2_fw {
	status = "okay";
};

&pcie3_fw {
	status = "okay";
};

&ethernet0 {
	pinctrl-0 = <&ethernet0_default>, <&ethernet0_phy_int>;
	pinctrl-names = "default";

	phy-mode = "usxgmii";
	phy-handle = <&sgmii_phy0>;

	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		sgmii_phy0: ethernet-phy@0 {
			compatible = "ethernet-phy-id31c3.1c12";
			reg = <0>;
			interrupts-extended = <&tlmm 141 IRQ_TYPE_EDGE_FALLING>;
			reset-gpios = <&pmau0102_e_gpios 5 GPIO_ACTIVE_LOW>;
			reset-assert-us = <11000>;
			reset-deassert-us = <70000>;
		};
	};
};

&ethernet1 {
	pinctrl-0 = <&ethernet1_default>, <&ethernet1_phy_int>;
	pinctrl-names = "default";

	phy-mode = "usxgmii";
	phy-handle = <&sgmii_phy1>;

	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		sgmii_phy1: ethernet-phy@8 {
			compatible = "ethernet-phy-id31c3.1c12";
			reg = <8>;
			interrupts-extended = <&tlmm 55 IRQ_TYPE_EDGE_FALLING>;
			reset-gpios = <&pmau0102_f_gpios 7 GPIO_ACTIVE_LOW>;
			reset-assert-us = <11000>;
			reset-deassert-us = <70000>;
		};
	};
};

&tlmm {
	ethernet0_phy_int: ethernet0-phy-int-state {
		pins = "gpio141";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	ethernet1_phy_int: ethernet1-phy-int-state {
		pins = "gpio55";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&uart4 {
	status = "okay";
};

&uart15 {
	status = "okay";
};

&ufs_mem_hc {
	status = "okay";
};

&xpcs0 {
	status = "okay";
};

&xpcs1 {
	status = "okay";
};

&usb_0 {
	status = "okay";
};

&usb_0_eusbphy {
	status = "okay";
};

&usb_0_qmpphy {
	status = "okay";
};

&usb_1 {
	status = "okay";
};

&usb_1_eusbphy {
	status = "okay";
};

&usb_1_qmpphy {
	status = "okay";
};
