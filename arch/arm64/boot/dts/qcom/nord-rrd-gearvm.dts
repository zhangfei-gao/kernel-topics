&soc {
	scmichannels: sram@d7600000 {
		compatible = "mmio-sram";
		reg = <0x0 0xd7600000 0x0 0x40000>;
		ranges = <0x0 0x0 0x0 0xffffffff>;
		#address-cells = <1>;
		#size-cells = <1>;

		shmem0: scmi-sram@d7600000 {
			compatible = "arm,scmi-shmem";
			reg = <0xd7600000 0x1000>;
		};

		shmem1: scmi-sram@d7601000 {
